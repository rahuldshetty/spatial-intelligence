# Spatial Intelligence — environment configuration
#
# Copy this file to `.env` and fill in your provider API key.
# `.env` is git-ignored; never commit real keys.

# Provider API key (standard env var read by pydantic-ai):
OPENAI_API_KEY=

# Optional: custom OpenAI-compatible endpoint (base URL).
# Leave empty to use OpenAI's default endpoint.
# Examples: Azure OpenAI, LiteLLM, vLLM, llama.cpp, Ollama, OpenRouter, DeepSeek.
# NOTE: this is the BASE URL only — pydantic-ai appends the route itself, so do
# NOT include the /chat/completions or /responses suffix.
#   OPENAI_BASE_URL=http://localhost:8080/v1
# With a base URL set, `openai:` and `openai-chat:` use the Chat Completions API
# (what self-hosted servers implement) and `openai-responses:` uses the
# Responses API. The API key is optional for an endpoint that does not check one.
OPENAI_BASE_URL=

# Optional: override the default model.
# Formats: openai:gpt-4o, openai-chat:qwen3, openai-responses:gpt-5,
#          anthropic:claude-sonnet-4-5,
#          google-gla:gemini-2.5-pro, ollama:llama3.1
GEOAI_MODEL=openai:gpt-4o

# Optional: data root for workspaces/, settings.json and this .env file.
# Default: the repo root in a dev checkout, else ~/.local/share/spatial-intelligence.
# GEOAI_HOME=

# Optional: how many times a prompt run retries before reporting an error
# (default 5). Tool errors are surfaced to the agent in-run; this bounds the
# retries for transient model/API failures.
GEOAI_MAX_RETRIES=5
