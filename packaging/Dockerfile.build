# Route B build: Spatial Intelligence as a single Linux AppImage.
#
# PyInstaller one-dir bundle built inside manylinux_2_28 (glibc 2.28) so the
# artifact runs on any distro from ~2019 on. The AppImage wrapper is produced
# with appimagetool in --appimage-extract-and-run mode (no FUSE needed in the
# container).
#
#   docker build -f packaging/Dockerfile.build --output dist .
#
# The base image is overridable, so a blocked or throttled registry can be
# swapped without editing this file (see packaging/README.md):
#
#   docker build -f packaging/Dockerfile.build --output dist \
#       --build-arg BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64:2026.09.05-1 .
#
# Output: dist/spatial-intelligence-<version>-x86_64.AppImage

# pypa publishes manylinux only on quay.io. Keep the glibc floor at 2.28: the
# AppImage inherits it, and that is what lets the artifact run on hosts from
# roughly 2019 on.
ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64:latest

FROM ${BASE_IMAGE} AS build

# PyInstaller requires a shared libpython. manylinux's bundled CPython is built
# static, so provision a python-build-standalone interpreter via uv.
# UV_PYTHON_PREFERENCE=only-managed stops uv from linking the venv to the
# (static) manylinux CPython it would otherwise discover first.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PYTHON_PREFERENCE=only-managed

WORKDIR /build

# Dependencies and the project are installed before the full context copy, so
# this (slow) layer is reused while unrelated files churn — the entry script,
# packaging files, docs, and the previous package.
COPY pyproject.toml ./
COPY spatial_intelligence/ spatial_intelligence/
COPY app.py ./

RUN uv venv --python 3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python . pyinstaller \
    && OPENCV_VERSION=$(/opt/venv/bin/python -c "import importlib.metadata as m; print(m.version('opencv-python'))") \
    && uv pip uninstall --python /opt/venv/bin/python opencv-python \
    && uv pip install --python /opt/venv/bin/python "opencv-python-headless==${OPENCV_VERSION}"

# Orthority requires the GUI OpenCV wheel; the AppImage must not, because it
# needs libGL/X11. Exactly one cv2 provider may remain in the bundle.
RUN /opt/venv/bin/python -c "import importlib.metadata as m; names = {d.metadata['Name'].lower() for d in m.distributions()}; assert 'opencv-python' not in names, 'GUI OpenCV wheel installed'; assert 'opencv-python-headless' in names, 'headless OpenCV missing'"

ENV PATH=/opt/venv/bin:$PATH

# Fail early and clearly if the interpreter lacks a shared libpython.
RUN python -c "import pathlib, sysconfig; lib = pathlib.Path(sysconfig.get_config_var('LIBDIR')) / 'libpython3.12.so.1.0'; assert lib.exists(), 'shared libpython missing at ' + str(lib)"

COPY . .

# Ship the pinned Marked bundle instead of letting the app fetch it on first
# launch: the bundle directory inside a mounted AppImage is read-only, so the
# runtime bootstrap cannot write there. PYTHONPATH puts the source tree first so
# the asset lands where PyInstaller will collect it from.
RUN PYTHONPATH=/build python -c "from spatial_intelligence.server.assets import MARKED_PATH, ensure_frontend_assets; ensure_frontend_assets(); assert MARKED_PATH.is_file() and MARKED_PATH.stat().st_size > 0, 'the Marked bundle is missing'; print('bundled', MARKED_PATH, MARKED_PATH.stat().st_size, 'bytes')"

RUN pyinstaller packaging/spatial-intelligence.spec \
        --noconfirm --distpath dist --workpath build-pyi

# AppDir layout: the PyInstaller bundle lives under usr/lib and
# usr/bin/spatial-intelligence is a real executable (Exec= must not point at a
# directory). The desktop file goes to the AppDir root (appimagetool's primary
# lookup) and to usr/share/applications (freedesktop convention).
RUN mkdir -p AppDir/usr/bin AppDir/usr/lib AppDir/usr/share/applications \
        AppDir/usr/share/icons/hicolor/128x128/apps \
        AppDir/usr/share/doc/spatial-intelligence/licenses \
    && cp -r dist/spatial-intelligence AppDir/usr/lib/spatial-intelligence \
    && cp packaging/spatial-intelligence.desktop AppDir/spatial-intelligence.desktop \
    && cp packaging/spatial-intelligence.desktop AppDir/usr/share/applications/spatial-intelligence.desktop \
    && cp packaging/icon.png AppDir/spatial-intelligence.png \
    && cp packaging/icon.png AppDir/usr/share/icons/hicolor/128x128/apps/spatial-intelligence.png \
    && cp packaging/THIRD_PARTY_NOTICES.md AppDir/usr/share/doc/spatial-intelligence/ \
    && cp packaging/licenses/ORTHORITY-AGPL-3.0-or-later.txt AppDir/usr/share/doc/spatial-intelligence/licenses/ \
    && ln -s spatial-intelligence.png AppDir/.DirIcon

COPY packaging/spatial-intelligence.sh AppDir/usr/bin/spatial-intelligence
COPY packaging/AppRun AppDir/AppRun
RUN chmod +x AppDir/usr/bin/spatial-intelligence AppDir/AppRun

RUN APPIMAGETOOL=/tmp/appimagetool \
    && curl -fsSL -o "$APPIMAGETOOL" \
        https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x "$APPIMAGETOOL" \
    && VERSION=$(python -c \
        "import tomllib; print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])") \
    && "$APPIMAGETOOL" --appimage-extract-and-run AppDir "spatial-intelligence-${VERSION}-x86_64.AppImage"
FROM scratch AS artifacts
COPY --from=build /build/*.AppImage /
